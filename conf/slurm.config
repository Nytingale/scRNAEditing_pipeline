// conf/slurm.config   Slurm settings for -profile slurm
// Use with the slurm profile, after nextflow.config:
//   nextflow run main.nf -profile slurm,conda -c conf/slurm.config ...
// The resource selectors of nextflow.config also set SGE clusterOptions ('-cwd -l mem=<memory>'), which sbatch
// rejects. Every selector there keeps `memory` equal to its `-l mem` (nextflow.config, MEMORY rule 1), so on Slurm
// the clusterOptions are dropped and `memory` alone sets --mem; cpus and time are unchanged. Executor settings are
// not part of the task hash, so -resume reuses the work directories of the SGE runs.
process {
    executor       = 'slurm'
    // queue          = '<partition>'   // your Slurm partition; unset = the cluster default
    clusterOptions = ''
    // a QOS wall-time limit (often 14 days) holds longer jobs in the queue for ever; set yours here; several
    // selectors ask for 420 h
    resourceLimits = [ time: 336.h ]
    // defined after nextflow.config's selectors, so these win over them
    withLabel: '.*' { clusterOptions = '' }
    withName: '.*'  { clusterOptions = '' }
}

executor {
    name            = 'slurm'
    queueSize       = 150
    submitRateLimit = '20/1s'
    pollInterval    = '30 sec'
}
