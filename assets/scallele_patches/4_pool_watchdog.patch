@@ -24,6 +24,25 @@
 from . import gqv_mutual_information  as MUTINFO
 
 
+# scRNAEditing patch: a pool worker killed by the cgroup OOM killer is silently replaced and its read cluster is
+# never returned, so imap_unordered waits forever. Workers only exit when killed (no maxtasksperchild), so any
+# change in the worker pids means a lost result: stop with a marker that the Nextflow errorStrategy retries on.
+def watched_imap(pool, worker_pids, func, args):
+	it = pool.imap_unordered(func, args)
+	while True:
+		try:
+			yield it.next(timeout = 30)
+		except StopIteration:
+			return
+		except multiprocessing.TimeoutError:
+			if {p.pid for p in pool._pool} != worker_pids:
+				sys.stderr.write("SCALLELE_WORKER_KILLED: a scAllele pool worker died (likely out of memory)\n")
+				sys.stderr.flush()
+				for p in pool._pool:
+					p.kill()
+				os._exit(137)
+
+
 
 __version__ = "0.0.9.4"
 
