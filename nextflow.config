/*
 * scRNAEditing pipeline configuration
 */

params {
    // Max resource limits
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '48.h'

    // STAR genome generation
    sjdb_overhang = 100

    save_intermediates = 0
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
    }

    sge {
        process.executor = 'sge'
        process.penv     = 'threaded'
        // Do not pass -V: Cursor/login env is huge and SGE's JSV rejects it
        // ("unknown command from JSV: ERROR"); conda profile sets task PATH.
        process.clusterOptions = '-cwd'
        executor.queueSize = 150
    }

    pbs {
        process.executor = 'pbs'
    }

    slurm {
        process.executor = 'slurm'
    }

    // Environment: --conda_env, else $SCRNA_CONDA_ENV, else the lock file. Must stay a
    // plain string (not a closure): a closure changes the task hash and breaks -resume.
    conda {
        conda.enabled = true
        process.conda = params.conda_env ?: (System.getenv('SCRNA_CONDA_ENV') ?: "${projectDir}/envs/scRNAEditing.linux-64.lock.txt")
    }

    // One image holds all three environments; scAllele and Cellsnp-lite are on PATH.
    // --container: another tag, a digest, or a local .sif (docker:// is added for registry names).
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = params.container ?: 'ghcr.io/nytingale/scrnaediting:1.0.0'
        params.cellsnp_bin     = 'cellsnp-lite'
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        process.container    = params.container ?: 'ghcr.io/nytingale/scrnaediting:1.0.0'
        params.cellsnp_bin   = 'cellsnp-lite'
    }

    docker {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
        process.container  = params.container ?: 'ghcr.io/nytingale/scrnaediting:1.0.0'
        params.cellsnp_bin = 'cellsnp-lite'
    }

    test {
        params.max_cpus   = 4
        params.max_memory = '16.GB'
        params.max_time   = '2.h'
    }
}

// Process resource defaults
process {
    // MEMORY: the SGE cgroup cap is min(h_rss, slots * 8 GB) with 1 slot per 2 cpus,
    // so `memory` alone is clamped to cpus * 4 GB. `-l mem` sets the cap without
    // changing cpus. Rules:
    //  1. Keep `memory` and `-l mem` equal: task.memory sets the GATK -Xmx
    //     (task.memory * 0.8) and is what pipeline_trace.txt reports.
    //  2. clusterOptions replaces the profile's '-cwd', so every entry repeats it.
    //  3. Overrides go in withName selectors here: labels override directives
    //     in process bodies, and withName beats withLabel.
    //  4. Retries on OOM must escalate memory, except for the callers.
    //  5. withName matches the full name, so aliases need wildcards.
    withLabel: 'process_low' {
        cpus           = 1
        memory         = '4.GB'
        time           = '2.h'
        clusterOptions = '-cwd -l mem=4G'
    }
    withLabel: 'process_medium' {
        cpus           = 4
        memory         = '16.GB'
        time           = '8.h'
        clusterOptions = '-cwd -l mem=16G'
    }
    withLabel: 'process_high' {
        cpus           = 8
        memory         = '64.GB'
        time           = '24.h'
        clusterOptions = '-cwd -l mem=64G'
    }
    // Benchmarked caller allocation: every caller runs at 12 cpus / 48 GB so
    // per-caller runtimes are comparable. Do not change per caller.
    withLabel: 'process_calling' {
        cpus           = 12
        memory         = '48.GB'
        time           = '420.h'
        clusterOptions = '-cwd -l mem=48G'
    }

    // Deep pseudobulk BAMs (Replogle NTC, 84 GB) need longer than 8 h.
    withName: 'SINTO_(GOOD_CELLS|ANNOTATED).*' {
        time = { task.attempt == 1 ? 24.h : 48.h }
    }

    // DOWNSTREAM_R: peak memory scales with site count (step 5 strand assignment);
    // inputs >= DF_CHUNK_MIN_MB are chunked by chromosome (bin/downstream_filter_chunked.sh).
    withName: 'DOWNSTREAM_R' {
        time           = '420.h'
        memory         = { (32 * 2**(task.attempt - 1)).GB }
        clusterOptions = { "-cwd -l mem=${32 * 2**(task.attempt - 1)}G" }
    }
    withName: 'DOWNSTREAM_R_SCALLELE' {
        time           = '420.h'
        memory         = { (32 * 2**(task.attempt - 1)).GB }
        clusterOptions = { "-cwd -l mem=${32 * 2**(task.attempt - 1)}G" }
    }

    withName: 'GATK_(SPLITNCIGAR|BQSR)' {
        time           = '420.h'
        memory         = { (64 + 32 * (task.attempt - 1)).GB }
        clusterOptions = { "-cwd -l mem=${64 + 32 * (task.attempt - 1)}G" }
    }

    withName: 'REDIPORTAL_OVERLAP' {
        memory         = { 16.GB * task.attempt }
        clusterOptions = { "-cwd -l mem=${16 * task.attempt}G" }
    }

    // An SGE memory kill leaves no exit code (recorded as Integer.MAX_VALUE), so
    // retry conditions include it. Dedup memory scales with the deepest contig.
    withName: 'UMI_DEDUP_CHROM' {
        cpus           = 2
        time           = '168.h'
        memory         = { (16 * (1 << (task.attempt - 1))).GB }
        clusterOptions = { "-cwd -l mem=${16 * (1 << (task.attempt - 1))}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 3
    }
    withName: 'UMI_DEDUP_GATHER' {
        cpus           = 4
        memory         = '16.GB'
        time           = '48.h'
        clusterOptions = '-cwd -l mem=16G'
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }
    // scAllele and JACUSA2 per chromosome: runtime is the sum over chromosome tasks,
    // not measured under process_calling.
    withName: 'SCALLELE_CHROM' {
        cpus           = 1
        time           = '420.h'
        memory         = { (16 * (1 << (task.attempt - 1))).GB }
        clusterOptions = { "-cwd -l mem=${16 * (1 << (task.attempt - 1))}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 3
    }

    // 3 GB heap per worker, as in the whole-genome task. Exit 3 = JVM OOM.
    withName: 'JACUSA2_CHROM' {
        cpus           = 4
        time           = '420.h'
        memory         = { (16 * (1 << (task.attempt - 1))).GB }
        clusterOptions = { "-cwd -l mem=${16 * (1 << (task.attempt - 1))}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [3, 137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 3
    }

    // sinto opens one BAM per cell per worker, so peak RAM scales with cpus.
    withName: 'SINTO_SPLIT_PERCELL.*' {
        cpus           = 2
        memory         = { 48.GB * task.attempt }
        clusterOptions = { "-cwd -l mem=${48 * task.attempt}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }

    withName: 'FILTER_UNIQUELY_MAPPED' {
        time = { task.attempt == 1 ? 24.h : 48.h }
    }

    // Callers retry at the same memory (benchmark parity). VALIDATE_FASTQ_READS is
    // deliberately left at 'terminate': input validation must hard-fail.
    withName: 'REDITOOLS3|BCFTOOLS_MPILEUP|CELLSNP_LITE' {
        errorStrategy = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    withName: 'PERCELL_.*|STARSOLO_ALIGN|STAR_GENOMEGENERATE' {
        memory         = { (64 + 32 * (task.attempt - 1)).GB }
        clusterOptions = { "-cwd -l mem=${64 + 32 * (task.attempt - 1)}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }

    withName: 'MARKDUP_CHROM' {
        cpus           = 2
        time           = '72.h'
        memory         = { (16 * (1 << (task.attempt - 1))).GB }
        clusterOptions = { "-cwd -l mem=${16 * (1 << (task.attempt - 1))}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 3
    }
    withName: 'MARKDUP_GATHER' {
        cpus           = 4
        memory         = '16.GB'
        time           = '48.h'
        clusterOptions = '-cwd -l mem=16G'
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }

    withName: 'MERGE_BAMS|MERGE_CELLTYPE_BAMS|SELECTIVE_MERGE.*|ADD_MD_TAG|COMPUTE_GOOD_CELLS|MARKDUP_PERCELL_SS2|SINTO_EXTRACT_CELLTYPE|SINTO_CELLTYPE_.*' {
        memory         = { 16.GB * task.attempt }
        clusterOptions = { "-cwd -l mem=${16 * task.attempt}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }

    withName: 'VALIDATE_BAMS|SKIP_DEDUP|REQUANT_PILEUP|INFER_STRANDEDNESS' {
        memory         = { 4.GB * task.attempt }
        clusterOptions = { "-cwd -l mem=${4 * task.attempt}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }

    withName: 'COLLATE_RESULTS' {
        memory         = { 8.GB * task.attempt }
        clusterOptions = { "-cwd -l mem=${8 * task.attempt}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_dag.html"
    overwrite = true
}

manifest {
    name            = 'scRNAEditing'
    author          = 'Ng & Tan'
    homePage        = 'https://github.com/Nytingale/scRNAEditing_pipeline'
    description     = 'Benchmarking pipeline for A-to-I RNA editing in single-cell transcriptomes'
    mainScript      = 'main.nf'
    version         = '1.0.0'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
