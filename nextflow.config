/*
 * scRNAEditing pipeline configuration
 */

params {
    // Max resource limits
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '48.h'

    // STAR genome generation
    sjdb_overhang = 100

    // Downstream filtering — save full site tables at each step (large files)
    save_intermediates = 0
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
    }

    sge {
        process.executor = 'sge'
        process.penv     = 'threaded'
        // Do not pass -V: Cursor/login env is huge and SGE's JSV rejects it
        // ("unknown command from JSV: ERROR"); conda profile sets task PATH.
        process.clusterOptions = '-cwd'
        executor.queueSize = 150
    }

    pbs {
        process.executor = 'pbs'
    }

    slurm {
        process.executor = 'slurm'
    }

    conda {
        conda.enabled = true
        process.conda = '/home/yng7/miniforge3/envs/scRNAEditing'
    }

    docker {
        docker.enabled = true
        process.container = 'nytingale/scRNAEditing:latest'
    }

    singularity {
        singularity.enabled = true
        process.container = 'docker://nytingale/scRNAEditing:latest'
    }

    test {
        params.max_cpus   = 4
        params.max_memory = '16.GB'
        params.max_time   = '2.h'
    }
}

// Process resource defaults
process {
    // ---------------------------------------------------------------------
    // MEMORY: every label sets BOTH `memory` and a matching `-l mem`.
    //
    // The enforced cgroup cap on this cluster is min(h_rss, slots * 8 GB), and
    // Nextflow allocates 1 slot per 2 cpus — so the `memory` directive alone is
    // silently clamped to cpus * 4 GB. MEASURED (render check, jobs 1692139 /
    // 1692193), declared -> actually enforced:
    //     process_low      1 cpu   4 GB  ->  4 GB   (not clamped, 4 <= 1*4)
    //     process_medium   4 cpus 16 GB  -> 16 GB   (not clamped, 16 <= 4*4)
    //     process_high     8 cpus 64 GB  -> 32 GB   <-- CLAMPED, silently halved
    //     process_calling 12 cpus 64 GB  -> 48 GB   <-- CLAMPED
    // `-l mem` sets the cap directly and is NOT scaled by thread count (unlike
    // `-l h_vmem`, which is per-thread), so it lifts the clamp WITHOUT changing
    // `cpus` — which is what preserves per-caller benchmark parity.
    //
    // RULES when editing:
    //  1. Keep `memory` and `-l mem` equal. `task.memory` feeds the GATK `-Xmx`
    //     expressions (`task.memory * 0.8`, keeping the heap 20% under the cap)
    //     and is what pipeline_trace.txt reports. Letting them drift recreates
    //     the original bug: a 51 GB heap under a 32 GB cap.
    //  2. clusterOptions REPLACES the profile's `process.clusterOptions = '-cwd'`,
    //     so every entry must re-include `-cwd` or the task cannot chdir.
    //  3. Put per-process escalation in a `withName` selector below, never in a
    //     process body — a body directive is silently overridden by the label.
    // ---------------------------------------------------------------------
    withLabel: 'process_low' {
        cpus           = 1
        memory         = '4.GB'
        time           = '2.h'
        clusterOptions = '-cwd -l mem=4G'
    }
    withLabel: 'process_medium' {
        cpus           = 4
        memory         = '16.GB'
        time           = '8.h'
        clusterOptions = '-cwd -l mem=16G'
    }
    withLabel: 'process_high' {
        cpus           = 8
        memory         = '64.GB'
        time           = '24.h'
        clusterOptions = '-cwd -l mem=64G'
    }
    // 48 GB, NOT 64: this is the benchmarked caller allocation and every
    // per-caller runtime on record was measured under it. It is also verified
    // sufficient — peak RSS on the deepest arm (Replogle merged NTC, 84 GB BAM)
    // was JACUSA2 37.7 GB, GATK_HAPLOTYPECALLER 10.3 GB, BCFTOOLS 2.6 GB,
    // SCALLELE 4.4 GB, REDITOOLS3 364 MB. The declaration is corrected from
    // 64 GB to 48 GB so `memory` states what is actually enforced (it was
    // reporting 64 GB while the cgroup granted 48) and so the JVM heaps derived
    // from it stay correct. Raising this would invalidate the runtime comparison
    // for no measured benefit.
    withLabel: 'process_calling' {
        cpus           = 12
        memory         = '48.GB'
        // 17.5 d (2.5 wk): Replogle merged NTC (84 GB BAM) needs multi-day
        // caller wall; teratoma finishes well under this — limit only caps,
        // does not change measured runtimes of completed jobs.
        time           = '420.h'
        clusterOptions = '-cwd -l mem=48G'
    }

    // ---------------------------------------------------------------------
    // Per-process overrides. These MUST live here rather than in the process
    // body: a config selector overrides a directive declared inside a process,
    // so `time`/`cpus` set next to the script are silently ignored whenever the
    // process also carries a withLabel (verified — SINTO_GOOD_CELLS still got
    // h_rt=08:00:00 with `time 24.h` in its body). withName beats withLabel.
    // ---------------------------------------------------------------------

    // sinto filterbarcodes on deep pseudobulk BAMs needs more than
    // process_medium's 8 h: the 84 GB Replogle NTC arm was SIGKILLed at exactly
    // 8 h. Covers every alias of SINTO_EXTRACT_QC.
    withName: 'SINTO_(GOOD_CELLS|ANNOTATED).*' {
        time = { task.attempt == 1 ? 24.h : 48.h }
    }

    // NOTE: deliberately NO per-caller cpus override. Every caller is benchmarked at
    // the identical process_calling allocation (12 cpus = 6 slots = 48 GB cgroup);
    // giving one caller more slots would break the per-caller runtime comparison and
    // would also run the deepest arm under different resources than the others. OOM
    // is handled by sizing JVM heaps from the ENFORCED cgroup — see variant_calling.nf.

    // =====================================================================
    // >>> MEMORY IS REQUESTED WITH `-l mem`, NOT THE `memory` DIRECTIVE <<<
    //
    // Nextflow's SGE executor turns `memory` into `-l h_rss=...,mem_free=...`.
    // Neither is ENFORCED here: the cgroup cap is set from the slot count
    // (2 cpus = 1 slot = 8 GB), so the effective ceiling is cpus * 4 GB no
    // matter what `memory` says. Measured: GATK_SPLITNCIGAR asked for 64 GB
    // (process_high) and was OOM-killed at MEM_LIMIT_G 32.00 = 8 cpus * 4 GB;
    // DOWNSTREAM_R asked for 16 GB and died at 16.00 = 4 cpus * 4 GB.
    //
    // `-l mem` sets the cap directly and is NOT scaled by the thread count
    // (unlike `-l h_vmem`, which is per-thread). So `-l mem` buys memory
    // WITHOUT changing `cpus` — which is what preserves the benchmark parity
    // documented in the NOTE above.
    //
    // Two rules when adding entries here:
    //   1. clusterOptions from a withName selector REPLACES the profile-level
    //      `process.clusterOptions = '-cwd'`, so every entry must re-include
    //      `-cwd` or the task fails with "can't chdir".
    //   2. Escalation must live HERE, not in the process body — a body-level
    //      `memory { ... * task.attempt }` is silently overridden by the
    //      process's own withLabel and never runs.
    // =====================================================================

    // `memory` and `-l mem` are ALWAYS set to the same number in each entry
    // below. `-l mem` is what the kernel enforces; `memory` is what `task.memory`
    // reports, which (a) feeds the GATK `-Xmx` expressions in gatk_preprocess.nf
    // (`task.memory * 0.8`, so the heap stays 20% under the enforced cap — the
    // ceiling-artefact fix from the JACUSA2 OOM) and (b) is what pipeline_trace.txt
    // publishes for the resource-reporting figures. Letting them drift reintroduces
    // the original bug: a 51 GB heap under a 32 GB cap.

    // The filter step. Its body-level `memory { 16.GB * task.attempt }` never
    // executed, so all 4 attempts ran at 16 GB and OOM-killed identically;
    // that is what put all three GT runs into `finish`/drain mode. Peak need is
    // driven by STEP 5 (annotation strand assignment) over the ~2M sites the
    // deep NTC arms yield from reditools3/jacusa2/scallele.
    // >>> THE LADDER IS NOW 32/64/128/256, NOT 32/64/96/128. <<<
    // The linear 32*attempt ladder topped out at 128 GB, and on the deepest arm
    // that was not enough: Replogle merged NTC OOM-killed at MEM_LIMIT_G 128.00
    // on attempt 4 (work dir 7e/ebc52991…, job draining the run at 18:57 on
    // 09-15) and again on a second task (88/a4a0f2ef…). Both died in STEP 5,
    // strand assignment, doing the annotation lookup over ALL sites at once:
    // 31,238,406 and 24,673,054 sites respectively, after SNP removal. Because
    // maxRetries is 3, attempt 4 exhausting the ladder flips errorStrategy to
    // `finish`, which DRAINS the whole run — the §2a failure mode.
    //
    // Doubling instead of adding keeps the first two rungs identical, so the
    // thousands of small teratoma tasks still start at 32 GB and the common case
    // costs nothing, while the deep arms actually get a rung above where they
    // die. Cluster nodes carry 2 TB, so 256 GB is well inside the hardware;
    // `params.max_memory` is advisory (referenced only in a comment), not a cap.
    //
    // THE REAL FIX IS IN THE SCRIPT, NOT HERE: STEP 5 materialises the
    // annotation lookup for every site simultaneously, so peak memory scales
    // linearly with site count and 256 GB only buys headroom rather than
    // removing the limit. Chunking that lookup is the durable remedy.
    withName: 'DOWNSTREAM_R' {
        // process_medium pins time to 8 h; Replogle NTC filter ran 6–7 h then
        // failed — give the deep arm the same 2.5 wk campaign budget.
        time           = '420.h'
        memory         = { (32 * 2**(task.attempt - 1)).GB }
        clusterOptions = { "-cwd -l mem=${32 * 2**(task.attempt - 1)}G" }
    }
    // Same budget for the scAllele copy (modules/downstream_r.nf).
    withName: 'DOWNSTREAM_R_SCALLELE' {
        time           = '420.h'
        memory         = { (32 * 2**(task.attempt - 1)).GB }
        clusterOptions = { "-cwd -l mem=${32 * 2**(task.attempt - 1)}G" }
    }

    // Same dead-directive bug: bodies asked for 64/96/128 GB by attempt, the
    // process_high label pinned task.memory to 64 GB (so -Xmx was 51 GB) while
    // the enforced cap was only 32 GB. Both now escalate together.
    //
    // time: process_high's 24 h SIGKILLed Replogle NTC GATK_SPLITNCIGAR at
    // exactly 23h59m (exit 140, nf_repl_gt 1714489). 17.5 d for the deep arm.
    withName: 'GATK_(SPLITNCIGAR|BQSR)' {
        time           = '420.h'
        memory         = { (64 + 32 * (task.attempt - 1)).GB }
        clusterOptions = { "-cwd -l mem=${64 + 32 * (task.attempt - 1)}G" }
    }

    withName: 'REDIPORTAL_OVERLAP' {
        memory         = { 16.GB * task.attempt }
        clusterOptions = { "-cwd -l mem=${16 * task.attempt}G" }
    }

    // OOM-killed on the Replogle merged NTC arm (job 1691011) at MEM_LIMIT_G
    // 32.00 = 8 cpus * 4 GB, 14.3 h in and still writing output at 189.3 M reads.
    // process_high's flat 64 GB is untested against that arm, and without a
    // ladder a shortfall costs 4 identical failures and flips the run to
    // `finish` — so escalate. umi_tools dedup holds the whole UMI/position
    // structure in RAM, so peak scales with arm depth, not with cpus: the same
    // job measured CPU_USE_PCT 12.54 across 8 cores.
    //
    // >>> The ladder below is USELESS without the errorStrategy. <<<
    // UMI_DEDUP declares no errorStrategy in its body and none is set globally
    // (the resolved config had ZERO errorStrategy entries), so Nextflow
    // defaulted to `terminate`: task.attempt could never reach 2 and the 96/128
    // GB steps were unreachable dead code, while a single OOM aborted the whole
    // run. Same class of bug as the dead body-level directives removed above,
    // one layer up — the escalation existed but nothing could trigger it.
    // maxRetries 2 = 3 attempts = exactly the 64/96/128 ladder.
    //
    // 2026-09-25: UMI_DEDUP replaced by UMI_DEDUP_CHROM (per chromosome x GEM
    // group) + UMI_DEDUP_GATHER (modules/dedup.nf). The single-task version
    // OOMed at 64 GB after 2.75 d on Replogle merged NTC (1.76 B reads) and was
    // NEVER retried: an SGE memory kill leaves no exit code, which Nextflow
    // records as Integer.MAX_VALUE, and the old condition sent that to `finish`.
    // Every retry condition below therefore includes Integer.MAX_VALUE.
    // Peak memory now scales with the deepest CONTIG; ladder 16/32/64/128 GB.
    withName: 'UMI_DEDUP_CHROM' {
        cpus           = 2
        time           = '168.h'
        memory         = { (16 * (1 << (task.attempt - 1))).GB }
        clusterOptions = { "-cwd -l mem=${16 * (1 << (task.attempt - 1))}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 3
    }
    withName: 'UMI_DEDUP_GATHER' {
        cpus           = 4
        memory         = '16.GB'
        time           = '48.h'
        clusterOptions = '-cwd -l mem=16G'
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }
    // scAllele per chromosome (modules/variant_calling.nf). One single-threaded
    // scAllele per task; its reported runtime is the SUM over its chromosome
    // tasks (human/scripts/nf_trace_scallele_runtime.R), so it is NOT measured
    // under the shared process_calling allocation used for the other callers.
    // The old 12-way-in-48 GB task OOMed on Replogle NTC before any contig
    // finished (the 4.4 GB peak noted above predates the 89.8 GB NTC BAM).
    withName: 'SCALLELE_CHROM' {
        cpus           = 1
        time           = '420.h'
        memory         = { (16 * (1 << (task.attempt - 1))).GB }
        clusterOptions = { "-cwd -l mem=${16 * (1 << (task.attempt - 1))}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 3
    }

    // Body asked for `cpus 2` + `memory 48.GB * attempt`; BOTH were overridden by
    // process_high, so it has been running 8-way. That inverts the documented
    // intent: sinto opens one output BAM per cell and duplicates the handle set
    // per worker, so peak RAM scales with cpus and 8 workers is the worst case.
    // cpus = 2 is restored here as a memory-correctness setting. It changes no
    // output — SINTO_SPLIT_PERCELL only splits a BAM by barcode.
    //
    // The trailing `.*` is load-bearing: withName matches FULL-STRING, so the
    // bare 'SINTO_SPLIT_PERCELL' selector did NOT match the alias
    // SINTO_SPLIT_PERCELL_DISC (main.nf), which therefore still ran under
    // process_high at 8 cpus — the exact inverted intent this entry exists to
    // correct, since sinto duplicates its per-cell file-handle set per worker.
    withName: 'SINTO_SPLIT_PERCELL.*' {
        cpus           = 2
        memory         = { 48.GB * task.attempt }
        clusterOptions = { "-cwd -l mem=${48 * task.attempt}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }

    // Body-level `time { task.attempt == 1 ? 24.h : 48.h }` was overridden by
    // process_high's 24 h, so the retry never got the longer wall clock.
    // (Memory needs no entry here: process_high now grants its full 64 GB.)
    withName: 'FILTER_UNIQUELY_MAPPED' {
        time = { task.attempt == 1 ? 24.h : 48.h }
    }

    // =====================================================================
    // >>> errorStrategy AUDIT (2026-09-16) <<<
    //
    // 19 of 30 processes declared NEITHER errorStrategy NOR maxRetries, and the
    // resolved config had ZERO errorStrategy entries globally — so each one
    // defaulted to `terminate` and a single transient OOM could abort an entire
    // multi-day run. COLLATE_RESULTS did exactly that to nf_pm_ps 1692628: every
    // upstream task succeeded (723 + 1498 cached, 0 cancelled) and the run died
    // at the final step, discarding ~28 h of compute over a 35-second R script.
    //
    // TWO RULES behind the entries below:
    //  1. A retry at the SAME memory reproduces an OOM identically — the "4
    //     identical failures" trap that flipped all three GT runs into drain
    //     mode. So every process that may retry on OOM also ESCALATES memory.
    //  2. EXCEPT the callers. REDITOOLS3/BCFTOOLS_MPILEUP get retry with NO
    //     memory change, because process_calling's 48 GB is the benchmarked
    //     allocation every recorded per-caller runtime was measured under, and
    //     because caller `-Xmx` is derived from `task.cpus`, not `task.memory`
    //     (variant_calling.nf) — so raising `memory` would break parity without
    //     even enlarging the heap. Measured peaks make it moot anyway:
    //     REDITOOLS3 364 MB, BCFTOOLS_MPILEUP 2.6 GB against a 48 GB cap.
    //
    // EVERY ladder below starts at its label's existing allocation, so attempt 1
    // is unchanged for all of them. Only the retry path is new — no first-attempt
    // resource, output or runtime changes anywhere.
    //
    // Process names are matched FULL-STRING, so aliases need explicit wildcards
    // (see main.nf: MERGE_CELLTYPE_BAMS, SELECTIVE_MERGE_{ANNOT,CT},
    // SINTO_CELLTYPE_*). Names verified against the `process` column of the
    // pipeline_trace.txt of all three GT runs, not inferred from the includes.
    //
    // DELIBERATELY EXCLUDED: VALIDATE_FASTQ_READS keeps errorStrategy
    // 'terminate'. Input validation must hard-fail; retrying it is wrong.
    // =====================================================================

    withName: 'REDITOOLS3|BCFTOOLS_MPILEUP' {
        errorStrategy = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    withName: 'PERCELL_.*|STARSOLO_ALIGN|STAR_GENOMEGENERATE' {
        memory         = { (64 + 32 * (task.attempt - 1)).GB }
        clusterOptions = { "-cwd -l mem=${64 + 32 * (task.attempt - 1)}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }

    // Coordinate dedup, per chromosome x GEM well (replaces GATK_MARKDUPLICATES;
    // see UMI_DEDUP_CHROM note above for the Integer.MAX_VALUE retry fix).
    withName: 'MARKDUP_CHROM' {
        cpus           = 2
        time           = '72.h'
        memory         = { (16 * (1 << (task.attempt - 1))).GB }
        clusterOptions = { "-cwd -l mem=${16 * (1 << (task.attempt - 1))}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 3
    }
    withName: 'MARKDUP_GATHER' {
        cpus           = 4
        memory         = '16.GB'
        time           = '48.h'
        clusterOptions = '-cwd -l mem=16G'
        errorStrategy  = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }

    withName: 'MERGE_BAMS|MERGE_CELLTYPE_BAMS|SELECTIVE_MERGE.*|ADD_MD_TAG|COMPUTE_GOOD_CELLS|MARKDUP_PERCELL_SS2|SINTO_EXTRACT_CELLTYPE|SINTO_CELLTYPE_.*' {
        memory         = { 16.GB * task.attempt }
        clusterOptions = { "-cwd -l mem=${16 * task.attempt}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }

    withName: 'VALIDATE_BAMS|SKIP_DEDUP|REQUANT_PILEUP|INFER_STRANDEDNESS' {
        memory         = { 4.GB * task.attempt }
        clusterOptions = { "-cwd -l mem=${4 * task.attempt}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }

    // The final step. It OOM-killed the 20-sample teratoma run TWICE — at the
    // bare process_low 4 GB (job 1693635) and again at a raised 32 GB (1705676)
    // — both times with every upstream task already succeeded, and both times
    // fatally, because it declared no errorStrategy and so defaulted to
    // `terminate`.
    //
    // >>> IT NO LONGER PLOTS, SO IT NO LONGER NEEDS THE MEMORY. <<<
    // Peak was never driven by the input (all_run_metrics.tsv is 1280 rows /
    // 337 KB). It was driven by ggplot: the script this process used to
    // system2() sized panels from the sample count, so a 20-sample run asked
    // scattermore for a 54,000 x 5,400 = 292 M px raster. collate_results.R is
    // now results-generation only — figures moved to
    // publication/benchmark_grid/ — so this task is a fread plus an fwrite.
    //
    // 8 GB is therefore ~25x the actual need and still leaves the ladder as
    // insurance for a much larger grid. The ladder and errorStrategy stay
    // because a single transient OOM must never again discard a completed run.
    withName: 'COLLATE_RESULTS' {
        memory         = { 8.GB * task.attempt }
        clusterOptions = { "-cwd -l mem=${8 * task.attempt}G" }
        errorStrategy  = { (task.exitStatus == null || task.exitStatus in [137, 140, 143, 104, 71]) ? 'retry' : 'finish' }
        maxRetries     = 2
    }
}

// Nextflow built-in tracing for time/memory reporting (addresses reviewer concern)
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_trace.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_report.html"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_dag.html"
    overwrite = true
}

// Manifest
manifest {
    name            = 'scRNAEditing'
    author          = 'Ng & Tan'
    homePage        = 'https://github.com/Nytingale/scRNAEditing'
    description     = 'Benchmarking pipeline for A-to-I RNA editing in single-cell transcriptomes'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
